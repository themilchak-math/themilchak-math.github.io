rules_version = '2';
// 더밀착수학 앱 보안 규칙
// - 원장님(config/main.owner)과 승인된 부원장(staff/{전화번호}.st=='ok')은 모든 데이터를 읽고 쓸 수 있어요.
// - 부원장 등록·승인, 앱 기본 설정은 원장님만 할 수 있어요.
// - 학부모·학생은 원장님이 승인해 연결한 아이(users/{uid}.sids)의 데이터만 볼 수 있어요.
// - 학생은 자기 숙제 '완료', 오늘 '하원'(학습 정리 후), 등원 요청(원장님 승인 필요)만 할 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function cfgPath() { return /databases/$(database)/documents/config/main; }
    function isOwner() { return signedIn() && exists(cfgPath()) && get(cfgPath()).data.owner == request.auth.uid; }
    function myPhone0() { return request.auth.token.email.split('@')[0]; }
    function staffPath() { return /databases/$(database)/documents/staff/$(myPhone0()); }
    function isStaff() { return signedIn() && exists(staffPath()) && get(staffPath()).data.st == 'ok' && get(staffPath()).data.uid == request.auth.uid; }
    function isTeacher() { return isOwner() || isStaff(); }
    function mePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(mePath()); }
    function me() { return get(mePath()).data; }
    function linked(sid) { return hasProfile() && sid in me().sids; }
    function isStudentOf(sid) { return linked(sid) && me().rels[sid] == 'student'; }
    function myThread(th) { return hasProfile() && th in me().ths; }
    function myPhone() { return request.auth.token.email.split('@')[0]; }
    // 문자 인증을 마친 계정: 로그인 번호와 인증한 휴대폰 번호가 같아요
    function phoneOk() { return signedIn() && request.auth.token.get('phone_number', '') == '+82' + myPhone().replace('^0', ''); }
    // 문자 인증 가입: 내 번호로 등록된 가족 1명을 원장님 승인 없이 바로 연결 (members 문서와 users 문서를 한 번에 저장할 때만)
    function selfLink(uid) {
      let d = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/members/$(d.via)).data;
      let old = resource == null ? {'sids': [], 'rels': {}, 'ths': []} : resource.data;
      let th = m.rel == 'student' ? [m.sid + '|student'] : [m.sid + '|parent', m.sid + '|' + m.rel];
      return d.keys().hasOnly(['phone', 'sids', 'rels', 'ths', 'via']) && d.via is string && d.phone == myPhone()
        && m.uid == uid && m.phone == myPhone() && m.st == 'ok'
        && d.sids.toSet().difference(old.sids.toSet()).hasOnly([m.sid]) && old.sids.toSet().difference(d.sids.toSet()).size() == 0
        && d.rels.diff(old.rels).affectedKeys().hasOnly([m.sid]) && d.rels[m.sid] == m.rel
        && d.ths.toSet().difference(old.ths.toSet()).hasOnly(th) && old.ths.toSet().difference(d.ths.toSet()).size() == 0;
    }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function qr() { return get(/databases/$(database)/documents/config/qr).data; }

    match /config/main {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if isOwner() && request.resource.data.owner == resource.data.owner;
      allow delete: if false;
    }
    match /config/hid {
      // 원장님·부원장이 소통 목록에서 닫은 대화 (목록에서만 숨김)
      allow read, write: if isTeacher();
    }
    match /config/qr {
      allow read, write: if isTeacher();
    }
    match /users/{uid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow write: if isTeacher();
      allow create, update: if signedIn() && request.auth.uid == uid && phoneOk() && selfLink(uid);
    }
    match /members/{id} {
      // 번호 등록·삭제는 원장님만, 가입 승인은 부원장도 가능
      // 본인 번호만 보여요. 아직 가입 안 한 등록 정보(학생 이름 등)는 그 번호로 문자 인증을 마쳐야 볼 수 있어요
      allow read: if isTeacher() || (signedIn() && resource.data.phone == myPhone() && (phoneOk() || resource.data.st != 'none'));
      allow create, delete: if isOwner();
      allow update: if isTeacher() || (phoneOk() && resource.data.phone == myPhone()
        && resource.data.st == 'none' && request.resource.data.st == 'pending'
        && request.resource.data.uid == request.auth.uid && onlyKeys(['st', 'uid', 'at']))
        // 문자 인증했으면 승인 없이 바로 연결: 내 users 문서도 같은 저장에서 이 등록(via)으로 연결될 때만
        || (phoneOk() && resource.data.phone == myPhone()
        && (resource.data.st == 'none' || (resource.data.st == 'pending' && resource.data.uid == request.auth.uid))
        && request.resource.data.st == 'ok' && request.resource.data.uid == request.auth.uid && onlyKeys(['st', 'uid', 'at'])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.via == id);
    }
    match /inv/{code} {
      // 예전 가입 코드(지금은 안 씀). 원장님만 정리할 수 있어요
      allow read, write: if isOwner();
    }
    match /students/{sid} {
      // 학생 등록·수정·퇴원은 원장님만. 부원장은 수업 기록 저장 때 현재 과정(course)만 바뀔 수 있어요
      allow read: if isTeacher() || linked(sid);
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isStaff() && onlyKeys(['course']));
    }
    match /att/{id} {
      allow read: if isTeacher() || linked(resource.data.sid);
      // 학생: 교습소 와이파이에서 앱을 열면 자기 오늘 등원만 자동 기록
      allow create: if isTeacher() || (isStudentOf(request.resource.data.sid)
        && id == request.resource.data.date + '_' + request.resource.data.sid
        && request.resource.data.st == '출석' && request.resource.data.by == 'wifi' && request.resource.data.logged == false
        && request.resource.data.keys().hasOnly(['sid', 'date', 'st', 'at', 'by', 'logged', 'ts']) && request.resource.data.ts == request.time);
      allow delete: if isTeacher();
      allow update: if isTeacher() || (isStudentOf(resource.data.sid) && resource.data.logged == true
        && resource.data.st != '결석' && !('out' in resource.data) && onlyKeys(['out']));
    }
    match /reqs/{id} {
      allow read: if isTeacher() || linked(resource.data.sid);
      allow create: if isStudentOf(request.resource.data.sid) && request.resource.data.uid == request.auth.uid
        && request.resource.data.st == 'pending';
      allow update: if isTeacher();
      allow delete: if isTeacher() || (isStudentOf(resource.data.sid) && resource.data.uid == request.auth.uid && resource.data.st == 'pending');
    }
    match /hw/{id} {
      allow read: if isTeacher() || linked(resource.data.sid);
      allow create, delete: if isTeacher();
      allow update: if isTeacher() || (isStudentOf(resource.data.sid) && resource.data.st == 'todo'
        && request.resource.data.st == 'done' && onlyKeys(['st', 'note']));
    }
    match /logs/{id} {
      allow read: if isTeacher() || (linked(resource.data.sid) && resource.data.sh == true);
      allow write: if isTeacher();
    }
    match /notices/{id} {
      // 소식 게시판: 공지(cat 없음/'notice')는 원장님만, 자료실·앨범·가정통신문은 원장님·부원장 작성
      // 학생·학부모는 읽기 + '확인했어요'(reads에 자기 uid 추가)만
      function catNew() { return request.resource.data.get('cat', 'notice'); }
      function catOld() { return resource.data.get('cat', 'notice'); }
      allow read: if isTeacher() || hasProfile();
      allow create: if isOwner() || (isStaff() && catNew() in ['data', 'album', 'letter']);
      allow delete: if isOwner() || (isStaff() && catOld() != 'notice');
      allow update: if isOwner() || (isStaff() && catOld() != 'notice' && catNew() != 'notice')
        || (hasProfile() && onlyKeys(['reads'])
        && request.resource.data.reads.toSet().difference(resource.data.reads.toSet()) == [request.auth.uid].toSet());
    }
    match /push/{id} {
      // 알림 받는 기기 목록. 'teacher' 또는 '학생id|student' / '학생id|parent'
      allow read: if isTeacher() || (signedIn() && id == 'teacher') || (hasProfile() && id.split('[|]')[0] in me().sids);
      allow create, update: if isTeacher() || (myThread(id) && request.resource.data.keys().hasOnly(['subs']));
      allow delete: if isTeacher();
    }
    match /msgs/{id} {
      allow read: if isTeacher() || myThread(resource.data.th);
      allow create: if isTeacher()
        || (myThread(request.resource.data.th) && request.resource.data.f == 'o')
        || (hasProfile() && request.resource.data.f == 's' && request.resource.data.sid in me().sids
            && request.resource.data.th in [request.resource.data.sid + '|parent', request.resource.data.sid + '|mother', request.resource.data.sid + '|father']);
      allow update: if (isTeacher() && onlyKeys(['r']))
        || (myThread(resource.data.th) && resource.data.f != 'o' && onlyKeys(['r']));
      allow delete: if isTeacher();
    }
    match /staff/{phone} {
      // 부원장: 원장님이 이름·번호 등록 → 부원장이 그 번호로 가입·문자 인증하면 바로 사용
      allow read: if isTeacher() || (signedIn() && phone == myPhone());
      allow create, delete: if isOwner();
      allow update: if isOwner() || (phoneOk() && phone == myPhone() && resource.data.st == 'none'
        && request.resource.data.st == 'pending' && request.resource.data.uid == request.auth.uid && onlyKeys(['st', 'uid', 'at']))
        // 원장님이 등록한 번호로 문자 인증까지 마치면 승인 없이 바로 사용
        || (phoneOk() && phone == myPhone() && (resource.data.st == 'none' || (resource.data.st == 'pending' && resource.data.uid == request.auth.uid))
        && request.resource.data.st == 'ok' && request.resource.data.uid == request.auth.uid && onlyKeys(['st', 'uid', 'at']));
    }
    match /exams/{id} {
      // 일정(시험기간·휴무·특수 일정): 원장님만 등록, 가입한 가족·부원장은 볼 수 있어요
      allow read: if isTeacher() || hasProfile();
      allow write: if isOwner();
    }
    match /sinfo/{sid} {
      // 학생명부 상세(생년월일·첫 등록일·메모·연락처): 원장님만
      allow read, write: if isOwner();
    }
    match /abs/{id} {
      // 결석 미리 알리기: 학부모가 날짜·사유를 올리고, 원장님·부원장이 확인. 올린 학부모는 취소 가능
      allow read: if isTeacher() || linked(resource.data.sid);
      allow create: if linked(request.resource.data.sid) && me().rels[request.resource.data.sid] != 'student'
        && id == request.resource.data.date + '_' + request.resource.data.sid
        && request.resource.data.uid == request.auth.uid && request.resource.data.ok == false
        && request.resource.data.keys().hasOnly(['sid', 'date', 'reason', 'uid', 'who', 'ts', 'ok']);
      allow update: if isTeacher();
      allow delete: if isTeacher() || (linked(resource.data.sid) && resource.data.uid == request.auth.uid);
    }
    match /sched/{sid} {
      // 학생별 수업 예정(등원 요일·보충 날짜): 원장님·부원장 기기가 맞춰 두고, 가족은 자기 아이 것만 읽어요
      allow read: if isTeacher() || linked(sid);
      allow write: if isTeacher();
    }
    match /calls/{id} {
      // 전화 상담 요청: 학부모가 날짜·시간대를 보내고 원장님·부원장이 확정. 요청한 학부모는 자기 요청만 보고 취소 가능
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if linked(request.resource.data.sid) && me().rels[request.resource.data.sid] != 'student'
        && request.resource.data.uid == request.auth.uid && request.resource.data.st == 'new'
        && request.resource.data.keys().hasOnly(['sid', 'uid', 'rel', 'who', 'phone', 'date', 'from', 'to', 'memo', 'st', 'ts'])
        && request.resource.data.from is int && request.resource.data.to is int && request.resource.data.memo.size() <= 200;
      allow update: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.st in ['new', 'ok']
        && request.resource.data.st == 'cancel' && onlyKeys(['st']));
      allow delete: if isTeacher();
    }
    match /extra/{date} {
      // 날짜별 보충 학생: 원장님·부원장만
      allow read, write: if isTeacher();
    }
    match /apply/{id} {
      // 신규 등록 신청서(join.html): 누구나 보낼 수 있고(로그인 없음), 원장님만 보고 승인·삭제
      allow create: if request.resource.data.keys().hasOnly(['name', 'school', 'grade', 'birth', 'pMother', 'pFather', 'pStudent', 'days', 'memo', 'st', 'ts'])
        && request.resource.data.st == 'new' && request.resource.data.ts == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.school is string && request.resource.data.school.size() <= 20
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 500
        && request.resource.data.days is list && request.resource.data.days.size() == 6;
      allow read, update, delete: if isOwner();
    }
    match /leads/{id} {
      // 무료 정밀진단·상담 기록(등록 전 학생·학부모 정보): 원장님만
      allow read, write: if isOwner();
    }
    match /forms/{tok} {
      // 상담 서류(consult.html): 원장님이 만든 추측 불가능한 링크로만, 링크가 열려 있을 때만 읽고 작성
      // 목록 조회·생성·삭제는 원장님만. 학부모·학생은 설문·신청서 칸만 쓸 수 있고, 제출된 입학신청서는 고칠 수 없어요
      allow get: if isOwner() || (resource.data.st == 'open');
      allow list, delete: if isOwner();
      // 비대면 입학신청서(join.html): 로그인 없이 새 문서만 만들 수 있고, 만든 뒤에는 읽기·수정 불가
      allow create: if isOwner() || (request.resource.data.st == 'remote'
        && request.resource.data.keys().hasOnly(['st', 'name', 'grade', 'school', 'src', 'apply', 'ts', 'up'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.apply is map && request.resource.data.up is int)
        // 학부모님이 직접 진단 예약 신청(consult.html?book=1): 열린 상담 서류로 만들어져 바로 설문까지 이어서 작성
        || (request.resource.data.st == 'open' && request.resource.data.self == 'book'
        && request.resource.data.keys().hasOnly(['st', 'self', 'name', 'grade', 'school', 'pMother', 'pStudent', 'src', 'wantDate', 'wantTime', 'note', 'ts', 'up'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.pMother is string && request.resource.data.pMother.matches('01[0-9]{8,9}')
        && request.resource.data.pStudent is string && request.resource.data.pStudent.matches('01[0-9]{8,9}')
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.up is int);
      allow update: if isOwner() || (resource.data.st == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parent', 'student', 'apply', 'up'])
        && (!('apply' in resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['apply']))
        && (!('parent' in request.resource.data) || request.resource.data.parent is map)
        && (!('student' in request.resource.data) || request.resource.data.student is map)
        && (!('apply' in request.resource.data) || request.resource.data.apply is map)
        && request.resource.data.up is int);
    }
    match /fin/{id} {
      // 정산(원비·식대): 원장님만
      allow read, write: if isOwner();
    }
  }
}
